<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>NexCart.API</RootNamespace>
    <UserSecretsId>6861ca00-1c3a-4d9c-a930-4ff4e4cf6b5b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexCart.Application\NexCart.Application.csproj" />
    <ProjectReference Include="..\NexCart.Infrastructure\NexCart.Infrastructure.csproj" />
    <ProjectReference Include="..\NexCart.Persistence\NexCart.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Asp.Versioning.Http" Version="6.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="6.0.0" />
  </ItemGroup>

  <!--
    On 'dotnet publish', build the React app and ship it in wwwroot/ so a single App Service
    serves both the frontend and the API from the same site (required by the SameSite=Strict
    auth cookie). Pass -p:SkipFrontendBuild=true to publish the API alone.
  -->
  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)\..\..\..\NexCart-Frontend\nexcart-web\</FrontendRoot>
  </PropertyGroup>

  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />

    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)dist\**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
